{
  "name": "rundocket",
  "version": "0.2.0",
  "description": "AI-first, framework-adaptive execution layer for app development.",
  "license": "MIT",
  "author": "Ulrich Diedrichsen <uli@moinsen.dev>",
  "homepage": "https://github.com/moinsen-dev/rundocket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moinsen-dev/rundocket.git"
  },
  "bugs": {
    "url": "https://github.com/moinsen-dev/rundocket/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "expo",
    "flutter",
    "xcode",
    "ios",
    "build",
    "cli",
    "agent-skills"
  ],
  "type": "module",
  "bin": {
    "rundocket": "./dist/src/cli.js",
    "rundocket-mcp": "./dist/src/mcp-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./dist/src/mcp.js"
    }
  },
  "files": [
    "dist/src/",
    "docs/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "mcp": "npm run build && node dist/src/mcp-cli.js",
    "smoke": "npm run build && node dist/src/cli.js inspect test/fixtures/expo-managed --json",
    "check": "npm run typecheck && npm test && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
